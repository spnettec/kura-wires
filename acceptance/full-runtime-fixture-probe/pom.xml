<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.eclipse.kura</groupId><artifactId>kura-build-parent</artifactId><version>6.0.0-SNAPSHOT</version><relativePath /></parent>
  <artifactId>kura-full-runtime-wire-fixture-acceptance</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>bundle</packaging>
  <dependencies>
    <dependency><groupId>org.eclipse.kura</groupId><artifactId>org.eclipse.kura.api</artifactId><version>3.0.0-SNAPSHOT</version><scope>provided</scope></dependency>
    <dependency><groupId>org.eclipse.kura</groupId><artifactId>org.eclipse.kura.core.configuration</artifactId><version>3.0.0-SNAPSHOT</version><scope>provided</scope></dependency>
    <dependency><groupId>org.osgi</groupId><artifactId>org.osgi.framework</artifactId><version>1.10.0</version><scope>provided</scope></dependency>
    <dependency><groupId>org.osgi</groupId><artifactId>org.osgi.service.component</artifactId><version>1.5.1</version><scope>provided</scope></dependency>
    <dependency><groupId>org.osgi</groupId><artifactId>org.osgi.service.wireadmin</artifactId><version>1.0.2</version><scope>provided</scope></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>2.0.17</version><scope>provided</scope></dependency>
    <dependency><groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>2.11.0</version><scope>provided</scope></dependency>
  </dependencies>
  <build><plugins>
    <!-- Compile the existing migrated driver unchanged, without copying a second source. -->
    <plugin><groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.1</version>
      <executions><execution><id>existing-test-driver</id><phase>generate-sources</phase><goals><goal>add-source</goal></goals>
        <configuration><sources><source>${project.basedir}/../../bundles/org.eclipse.kura.rest.wire.provider/src/test/java</source></sources></configuration>
      </execution></executions>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
      <configuration><includes><include>org/eclipse/kura/wires/testing/fullruntime/*.java</include><include>org/eclipse/kura/rest/wire/provider/test/ChannelDescriptorTestDriver.java</include></includes></configuration>
    </plugin>
    <plugin><groupId>org.apache.felix</groupId><artifactId>maven-bundle-plugin</artifactId><extensions>true</extensions>
      <configuration><instructions>
        <Bundle-SymbolicName>org.eclipse.kura.testing.fullruntime.wirefixtures</Bundle-SymbolicName>
        <Bundle-Activator>org.eclipse.kura.wires.testing.fullruntime.FixtureProbe</Bundle-Activator>
        <Bundle-RequiredExecutionEnvironment>JavaSE-21</Bundle-RequiredExecutionEnvironment>
        <Service-Component>OSGI-INF/driver.xml,OSGI-INF/emitter.xml</Service-Component>
        <Private-Package>org.eclipse.kura.wires.testing.fullruntime,org.eclipse.kura.rest.wire.provider.test</Private-Package><Export-Package>!*</Export-Package>
      </instructions></configuration>
    </plugin>
  </plugins></build>
</project>
